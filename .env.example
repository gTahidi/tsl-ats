# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=tsl-ats-backend
OTEL_SERVICE_VERSION=1.0.0
OTEL_RESOURCE_ATTRIBUTES=service.name=tsl-ats-backend,service.version=1.0.0,deployment.environment=production

# Grafana Cloud Configuration
# Get these values from your Grafana Cloud stack at https://grafana.com/
GRAFANA_CLOUD_API_KEY=your_grafana_cloud_api_key_here
GRAFANA_CLOUD_INSTANCE_ID=your_grafana_cloud_instance_id_here
GRAFANA_CLOUD_ZONE=your_grafana_cloud_zone_here

# Grafana Cloud Endpoints (replace with your actual endpoints)
# Loki endpoint for logs
GRAFANA_CLOUD_LOKI_ENDPOINT=https://logs-prod-us-central1.grafana.net/loki/api/v1/push
# Tempo endpoint for traces  
GRAFANA_CLOUD_TEMPO_ENDPOINT=https://tempo-prod-04-prod-us-central-0.grafana.net:443
# Prometheus endpoint for metrics
GRAFANA_CLOUD_PROMETHEUS_ENDPOINT=https://prometheus-prod-01-prod-us-central-0.grafana.net/api/v1/push

# Grafana Faro Configuration (Frontend Observability)
# Get these from your Grafana Cloud Application Observability section
NEXT_PUBLIC_FARO_URL=https://faro-collector-prod-us-central-0.grafana.net/collect/your_app_key_here
NEXT_PUBLIC_FARO_APP_NAME=tsl-ats-frontend
NEXT_PUBLIC_FARO_APP_NAMESPACE=production
NEXT_PUBLIC_FARO_ENVIRONMENT=production

# Alternative Grafana Cloud OTLP Configuration (if using OTLP instead of direct Faro)
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic your_base64_encoded_credentials_here

# Other existing environment variables...
# Add your other environment variables here